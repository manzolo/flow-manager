# Copia questo file in .env e cambia i valori.

# Login admin per il builder e le API di scrittura (minimo 8 caratteri).
# Senza una password vera il login resta disabilitato.
ADMIN_MODE=True
ADMIN_PASSWORD=

# Chiave delle sessioni: generala con  python3 -c "import secrets; print(secrets.token_hex(32))"
# Se manca se ne usa una casuale a ogni avvio (il login admin non sopravvive al riavvio).
SECRET_KEY=

# Testi del sito (opzionali)
#SITE_TITLE=Flow Manager
#SITE_SUBTITLE=Crea e gestisci flussi decisionali interattivi
#SITE_TAGLINE=Flussi decisionali interattivi descritti in YAML.
#ORG_NAME=La mia organizzazione
#ORG_URL=https://example.org

# Dietro HTTPS
#SESSION_COOKIE_SECURE=True
#ALLOWED_ORIGINS=https://flussi.example.org

# Porta pubblicata da docker compose
#PORT=8000
